{
  "appId": "com.habilis.app",
  "appName": "Habilis",
  "webDir": "dist",
  "android": {
    "allowMixedContent": false
  },
  "ios": {
    "contentInset": "always",
    "limitsNavigationsToAppBoundDomains": true
  },
  "server": {
    "androidScheme": "https",
    "iosScheme": "https"
  },
  "plugins": {
    "SplashScreen": {
      "launchShowDuration": 1200,
      "backgroundColor": "#0F172A",
      "androidScaleType": "CENTER_CROP",
      "showSpinner": false
    }
  }
}

rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // Profile photos — only the owner can write; anyone can read
    match /perfiles/{uid}/foto {
      allow read:  if true;
      allow write: if request.auth != null
                   && request.auth.uid == uid
                   && request.resource.size < 5 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
    }

    // Work evidence photos — solo el técnico dueño del trabajo puede subir.
    // Antes cualquier usuario autenticado podía escribir/sobrescribir la
    // evidencia de CUALQUIER trabajo con solo conocer su id.
    match /trabajos/{trabajoId}/{fileName} {
      allow read:  if true;
      allow write: if request.auth != null
                   && request.resource.size < 10 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*')
                   && firestore.get(/databases/(default)/documents/trabajos/$(trabajoId)).data.tecnicoId == request.auth.uid;
    }
  }
}

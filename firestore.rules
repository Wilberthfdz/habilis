rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // El correo por sí solo no acredita: un proveedor de identidad mal
    // configurado puede emitir un token con un email ajeno sin verificar.
    function isAdmin() {
      return request.auth != null
        && request.auth.token.get("email", "") == "wilberthfdz@gmail.com"
        && request.auth.token.get("email_verified", false) == true;
    }

    function esDuenio(campo) {
      return request.auth != null && resource.data[campo] == request.auth.uid;
    }

    function creaComoDuenio(campo) {
      return request.auth != null && request.resource.data[campo] == request.auth.uid;
    }

    function cambia() {
      return request.resource.data.diff(resource.data).affectedKeys();
    }

    match /tecnicos/{uid} {
      allow read:   if true;
      // Sin esto, el propio documento de alta podía nacer con plan:"pro",
      // verificado:true o rating:5 — el usuario se regalaba la suscripción y
      // la insignia en su primera escritura.
      allow create: if isAdmin() || (
        request.auth != null && request.auth.uid == uid
        && request.resource.data.plan == "gratis"
        && request.resource.data.get("verificado", false) == false
        && request.resource.data.get("rating", 0) == 0
        && request.resource.data.get("totalTrabajos", 0) == 0
        && !request.resource.data.keys().hasAny(['rankScore','suscripcionId','suscripcionEstado','fechaPago','suspendido'])
        // Consentimiento expreso obligatorio. La casilla del alta ya lo
        // exige en el cliente; aquí se vuelve infranqueable, para que no
        // exista un solo perfil sin constancia de aceptación.
        && request.resource.data.get("aceptoTerminos", false) == true
      );
      // El dueño solo puede tocar campos de perfil "seguros" — plan, verificado,
      // rating, rankScore, etc. son SOLO backend (agentes / webhook de pago).
      // Antes cualquier usuario podía hacer updateDoc({plan:"pro"}) directo
      // desde el cliente y volverse Pro gratis — ver SECURITY_AUDIT.md #1.
      allow update: if isAdmin() || (
        request.auth != null && request.auth.uid == uid &&
        request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['nombre','oficio','ciudad','experiencia','bio','fotoUrl','alcance','disponible','updatedAt'])
      );
      allow delete: if isAdmin();
    }

    match /trabajos/{trabajoId} {
      allow read:   if true;
      // Tope de 5 trabajos del plan gratuito. Se anunciaba en Precios desde
      // el principio y no existía: el plan gratuito documentaba tantos como
      // quisiera, así que "trabajos ilimitados" no era ventaja del Pro. El
      // contador lo mantiene una Cloud Function al crear cada trabajo; ante
      // creaciones simultáneas puede quedar corto un instante, y es un tope
      // de producto, no una barrera de seguridad.
      allow create: if creaComoDuenio('tecnicoId') && (
        get(/databases/$(database)/documents/tecnicos/$(request.auth.uid)).data.plan == "pro"
        || get(/databases/$(database)/documents/tecnicos/$(request.auth.uid)).data.get("trabajosCreados", 0) < 5
      );
      // El técnico puede corregir su propio trabajo, pero NO el veredicto de
      // moderación ni los contadores de reputación: eso es del backend.
      allow update: if isAdmin() || (
        esDuenio('tecnicoId')
        && cambia().hasOnly(['titulo','descripcion','problema','solucion','fotos','updatedAt'])
      );
      allow delete: if isAdmin();
    }

    match /solicitudes/{solicitudId} {
      // Contienen la descripción del problema y la ciudad de un domicilio:
      // no es información pública.
      allow read:   if request.auth != null;
      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    // Habilis Care — equipment assets (owner only, admin can view/manage all)
    match /activos/{activoId} {
      allow read:   if (request.auth != null && resource.data.userId == request.auth.uid) || isAdmin();
      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;
      allow update: if (request.auth != null && resource.data.userId == request.auth.uid) || isAdmin();
      allow delete: if (request.auth != null && resource.data.userId == request.auth.uid) || isAdmin();
    }

    // Service history records
    // El historial de mantenimiento es del dueño del equipo. Antes cualquier
    // usuario registrado podía leerlo y EDITARLO, con costos incluidos.
    match /servicios/{servicioId} {
      allow read:   if esDuenio('userId') || isAdmin();
      allow create: if creaComoDuenio('userId');
      allow update: if esDuenio('userId') || isAdmin();
      allow delete: if esDuenio('userId') || isAdmin();
    }

    // Care subscription plans
    match /planes_care/{planId} {
      allow read:   if (request.auth != null && resource.data.clienteId == request.auth.uid) || isAdmin();
      allow create: if creaComoDuenio('clienteId');
      // El estado y el cobro del plan los decide el backend, no el cliente.
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    // Cotizaciones — public read (cotizacionId is the "token").
    // El cliente público (sin login) SOLO puede cambiar `estado` a
    // aceptada/rechazada — antes "allow update: if true" dejaba reescribir
    // precio, datos del técnico o cualquier campo del documento completo.
    match /cotizaciones/{cotId} {
      // `get` abierto conserva el enlace que el técnico manda por WhatsApp;
      // `list` cerrado impide descargar la cartera de clientes completa —
      // con RFC, correo y teléfono— de todos los técnicos de la plataforma.
      allow get:    if true;
      allow list:   if esDuenio('tecnicoId') || isAdmin();
      allow create: if request.auth != null && request.resource.data.tecnicoId == request.auth.uid;
      allow update: if isAdmin()
        || (request.auth != null && resource.data.tecnicoId == request.auth.uid)
        || (
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['estado','updatedAt'])
          && request.resource.data.estado in ['aceptada','rechazada']
        );
      allow delete: if isAdmin();
    }

    // Folio counters (owner only)
    match /cotizaciones_folio/{tecnicoId} {
      allow read:   if request.auth != null && request.auth.uid == tecnicoId;
      allow write:  if request.auth != null && request.auth.uid == tecnicoId;
    }

    // Technician client directory — antes cualquier usuario autenticado
    // podía leer/editar/borrar el directorio de clientes de OTRO técnico
    // (IDOR). Ahora restringido al dueño (tecnicoId) o admin.
    match /clientes_tecnico/{clienteId} {
      allow read:   if (request.auth != null && resource.data.tecnicoId == request.auth.uid) || isAdmin();
      allow create: if request.auth != null && request.resource.data.tecnicoId == request.auth.uid;
      allow update, delete: if (request.auth != null && resource.data.tecnicoId == request.auth.uid) || isAdmin();
    }

    // Technician product catalog — mismo fix de IDOR que clientes_tecnico.
    match /productos_tecnico/{productoId} {
      allow read:   if (request.auth != null && resource.data.tecnicoId == request.auth.uid) || isAdmin();
      allow create: if request.auth != null && request.resource.data.tecnicoId == request.auth.uid;
      allow update, delete: if (request.auth != null && resource.data.tecnicoId == request.auth.uid) || isAdmin();
    }

    // Conversaciones privadas: solo el cliente y el técnico de cada una.
    // Antes bastaba una cuenta gratuita para leer TODOS los chats de la
    // plataforma, y para mover cualquier solicitud a "aceptado".
    match /solicitudes_chat/{solicitudId} {
      function esParte() {
        return request.auth != null && (
          resource.data.clienteId == request.auth.uid ||
          resource.data.tecnicoId == request.auth.uid
        );
      }

      allow read:   if esParte() || isAdmin();
      allow create: if creaComoDuenio('clienteId');
      allow update: if isAdmin() || (
        esParte()
        && cambia().hasOnly(['estado','resumenIA','trabajoId','updatedAt'])
      );
      allow delete: if false;

      match /mensajes/{mensajeId} {
        function parteDelChat() {
          let chat = get(/databases/$(database)/documents/solicitudes_chat/$(solicitudId)).data;
          return request.auth != null &&
            (chat.clienteId == request.auth.uid || chat.tecnicoId == request.auth.uid);
        }

        allow read:   if parteDelChat() || isAdmin();
        // El autor no se puede falsificar: sin esto se podían inyectar
        // mensajes firmados como la otra persona. Los avisos de sistema
        // siguen permitidos a las partes (los escribe la propia pantalla al
        // aceptar o rechazar) pero con autor fijo; moverlos al backend queda
        // pendiente para que nadie pueda imitar a Habilis dentro del chat.
        allow create: if parteDelChat() && (
          (request.resource.data.tipo == 'mensaje' && request.resource.data.autorId == request.auth.uid)
          || (request.resource.data.tipo == 'sistema' && request.resource.data.autorId == 'sistema')
        );
        allow update: if false;
        allow delete: if false;
      }
    }

    // Validación social — un voto por persona, trabajo y tipo. El ID del
    // documento codifica esa unicidad, así que la regla exige que coincida:
    // de lo contrario se podían crear votos a nombre de otros, de tipos
    // inventados, o votarse a uno mismo desde otro ID.
    match /validaciones/{validacionId} {
      allow read:   if true;
      allow create: if request.auth != null
        && request.resource.data.validadorId == request.auth.uid
        && request.resource.data.tipo in ['util','bien_hecho']
        && validacionId == request.resource.data.trabajoId + '_'
                         + request.auth.uid + '_'
                         + request.resource.data.tipo
        && get(/databases/$(database)/documents/trabajos/$(request.resource.data.trabajoId)).data.tecnicoId
             != request.auth.uid;
      allow update: if false;
      allow delete: if isAdmin();
    }

    // Technician collaboration network (subcollection per user)
    match /red_colaboradores/{userId}/lista/{tecnicoId} {
      allow read:   if request.auth != null && request.auth.uid == userId;
      allow write:  if request.auth != null && request.auth.uid == userId;
    }

    // ── Agentes autónomos (Cloud Functions) — los agentes usan el Admin
    // SDK, que ignora estas reglas; son estrictas a propósito porque solo
    // protegen el acceso desde el cliente.

    // Notificaciones generadas por los agentes — cada usuario ve las suyas
    match /notificaciones/{id} {
      allow read, update: if (request.auth != null && resource.data.userId == request.auth.uid) || isAdmin();
      allow create: if isAdmin(); // el marketing masivo del admin crea desde el cliente; los agentes usan Admin SDK
      allow delete: if (request.auth != null && resource.data.userId == request.auth.uid) || isAdmin();
    }

    // Pagos — el dueño lee los suyos; el admin lee y registra pagos manuales
    match /pagos/{id} {
      allow read:   if (request.auth != null && resource.data.userId == request.auth.uid) || isAdmin();
      allow create: if isAdmin();
      allow update, delete: if isAdmin();
    }

    // Suscripciones pendientes de confirmación de Mercado Pago
    match /suscripcionesPendientes/{uid} {
      allow read:  if (request.auth != null && request.auth.uid == uid) || isAdmin();
      allow write: if false; // solo el backend (Admin SDK)
    }

    // Facturas CFDI — el dueño lee las suyas; el admin lee todas
    match /facturas/{id} {
      allow read:  if (request.auth != null && resource.data.userId == request.auth.uid) || isAdmin();
      allow write: if false; // solo el backend (Admin SDK)
    }

    // Logs de decisiones de agentes — evidencia para el XPRIZE.
    // Solo el admin (panel ERP) puede leerlos desde el cliente.
    match /aiLogs/{id} {
      allow read:  if isAdmin();
      allow write: if false; // solo los agentes (Admin SDK)
    }

    // Webhooks de pago que fallaron: quedan para reprocesar y conciliar.
    // Contienen el cuerpo crudo de Mercado Pago, así que no salen del admin.
    match /webhooksFallidos/{id} {
      allow read:  if isAdmin();
      allow write: if false; // solo el backend (Admin SDK)
    }

    // Rate limiting interno — nunca accesible desde el cliente
    match /rateLimits/{id} {
      allow read, write: if false;
    }

    // Gastos del negocio (Admin ERP → Finanzas → Reporte XPRIZE)
    match /gastos/{id} {
      allow read, write: if isAdmin();
    }

    // Códigos promocionales (Admin ERP → Marketing).
    // La lectura es solo del admin: en abierto, cualquiera podía listar la
    // colección y quedarse con todos los códigos vigentes. La validación al
    // suscribirse ocurre server-side en `crearSuscripcion`, así que el
    // cliente no necesita leerlos.
    match /promos/{id} {
      allow read:  if isAdmin();
      allow write: if isAdmin();
    }

    // Configuración general del sitio (precio Pro, modo mantenimiento, etc.)
    match /config/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Log de auditoría del ERP: toda acción del admin queda registrada
    match /adminLogs/{id} {
      allow read, create: if isAdmin();
      allow update, delete: if false; // el rastro no se edita ni se borra
    }
  }
}

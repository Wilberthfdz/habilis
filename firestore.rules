rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null &&
        request.auth.token.email in ["wilberthfdz@gmail.com", "frnlcm13@gmail.com"];
    }

    match /tecnicos/{uid} {
      allow read:   if true;
      // isAdmin() puede crear con cualquier id (onboarding en persona desde
      // el ERP, antes de que la persona tenga cuenta propia) — ver #8 de la
      // auditoría del 16 ago.
      // Los perfiles de empleados (empresaId) se crean SOLO vía la Cloud
      // Function crearEmpleado (Admin SDK, que ignora estas reglas) — ahí
      // se hace cumplir el tope de 10 por cuenta Empresa. Las reglas no
      // pueden contar documentos existentes de forma confiable, así que
      // dejar un create directo aquí abría la puerta a saltarse el tope.
      // El auto-registro debe nacer "gratis"/sin verificar — sin este freno
      // faltaba en `create` el mismo candado que ya tiene `update`, y un
      // setDoc directo desde el cliente podía nacer con plan:"empresa" o
      // verificado:true gratis (crearEmpleado en el backend confía en el
      // campo `plan` que quede aquí guardado).
      allow create: if isAdmin() || (
        request.auth != null && request.auth.uid == uid &&
        request.resource.data.plan == "gratis" &&
        request.resource.data.verificado == false &&
        request.resource.data.rating == 0 &&
        request.resource.data.totalTrabajos == 0
      );
      // El dueño solo puede tocar campos de perfil "seguros" — plan, verificado,
      // rating, rankScore, etc. son SOLO backend (agentes / webhook de pago).
      // Antes cualquier usuario podía hacer updateDoc({plan:"pro"}) directo
      // desde el cliente y volverse Pro gratis — ver SECURITY_AUDIT.md #1.
      allow update: if isAdmin() || (
        request.auth != null && request.auth.uid == uid &&
        request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['nombre','oficio','ciudad','experiencia','bio','fotoUrl','alcance','disponible','slug','updatedAt'])
      ) || (
        // La empresa dueña administra el perfil de su empleado (mismos campos
        // "seguros" que un técnico independiente editaría de sí mismo).
        request.auth != null && resource.data.empresaId == request.auth.uid &&
        request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['nombre','oficio','categoriaId','ciudad','experiencia','bio','fotoUrl','disponible','slug','updatedAt'])
      );
      allow delete: if isAdmin()
        || (request.auth != null && resource.data.empresaId == request.auth.uid);
    }

    // Reserva de slugs bonitos (myhabilis.com/t/juan-electricista). El id del
    // documento ES el slug — así una transacción que hace tx.get() antes de
    // tx.set() garantiza unicidad real (dos personas no pueden reservar el
    // mismo slug a la vez). Solo el dueño del perfil puede reclamar/soltar
    // su propio slug; nunca se permite "update" — cambiar de slug es
    // borrar la reserva vieja y crear una nueva.
    match /slugs/{slug} {
      allow read: if true;
      allow create: if request.auth != null &&
        request.resource.data.tecnicoId == request.auth.uid &&
        slug.matches('^[a-z0-9-]{3,60}$');
      allow delete: if isAdmin() ||
        (request.auth != null && resource.data.tecnicoId == request.auth.uid);
      allow update: if false;
    }

    // Agenda — disponibilidad semanal (beneficio Pro/Empresa, mismo candado
    // que activos/cotizaciones: get() confirma el plan pagante). Lectura
    // pública porque el propio perfil la muestra, pero reservar una cita de
    // verdad pasa por la Cloud Function reservarCita (evita condiciones de
    // carrera y no expone nombre/teléfono de otros clientes en el cálculo
    // de horarios libres).
    match /disponibilidad/{uid} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == uid &&
        get(/databases/$(database)/documents/tecnicos/$(uid)).data.plan in ['pro','empresa'];
    }

    // Citas agendadas — solo las crea/cancela reservarCita/cancelarCita
    // (Cloud Functions, Admin SDK). Un write directo desde el cliente
    // podría saltarse la validación de horario o pisar la reserva de otra
    // persona; con create/update en false aquí, la única vía es el backend.
    match /citas/{id} {
      allow read: if request.auth != null &&
        (resource.data.tecnicoId == request.auth.uid || resource.data.clienteId == request.auth.uid) || isAdmin();
      allow create, update, delete: if isAdmin();
    }

    // Verificación de identidad — INE + comprobante de oficio. A diferencia
    // de tecnicos, NO es pública: solo el dueño y el admin ven los documentos.
    // El dueño puede volver a subir tras un rechazo, pero no auto-aprobarse
    // (estado solo puede quedar en "pendiente" desde su propio update).
    match /verificaciones/{uid} {
      allow read:   if (request.auth != null && request.auth.uid == uid) || isAdmin();
      allow create: if request.auth != null && request.auth.uid == uid &&
        request.resource.data.estado == "pendiente";
      allow update: if isAdmin() || (
        request.auth != null && request.auth.uid == uid &&
        request.resource.data.estado == "pendiente"
      );
      allow delete: if isAdmin();
    }

    // Perfiles de cliente — a diferencia de tecnicos, NO son públicos: solo
    // el dueño (o el admin) puede leerlos.
    match /clientes/{uid} {
      allow read:   if (request.auth != null && request.auth.uid == uid) || isAdmin();
      allow create: if request.auth != null && request.auth.uid == uid;
      allow update: if isAdmin() || (
        request.auth != null && request.auth.uid == uid &&
        request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['nombre','telefono','ciudad','updatedAt'])
      );
      allow delete: if isAdmin();
    }

    match /trabajos/{trabajoId} {
      allow read:   if true;
      // Se crea SOLO vía la Cloud Function crearTrabajo (Admin SDK, que
      // ignora esta regla) — ahí se hace cumplir el tope de 5 trabajos del
      // plan Gratis, que las reglas no pueden contar de forma confiable.
      allow create: if isAdmin();
      // El dueño solo puede tocar evidencias/estado del propio trabajo — antes
      // podía reescribir cualquier campo (incluido costoTotal, ya usado en
      // reportes de Finanzas, o reasignar tecnicoId a otra cuenta).
      allow update: if isAdmin() || (
        request.auth != null && resource.data.tecnicoId == request.auth.uid &&
        request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['estado','evidencias','updatedAt'])
      );
      allow delete: if isAdmin();
    }

    match /solicitudes/{solicitudId} {
      allow read:   if true;
      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;
      // Cualquier autenticado puede sumarle una respuesta (técnico
      // respondiendo desde el Feed) — todo lo demás sigue solo-admin.
      allow update: if isAdmin() || (
        request.auth != null &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['respuestas'])
      );
      allow delete: if isAdmin();
    }

    // Habilis Care — equipment assets (owner only, admin can view/manage all).
    // Gratis siempre para clientes; para cuentas de técnico exige Pro/Empresa
    // (antes solo lo bloqueaba la UI en HabilisCare.jsx — un setDoc directo
    // desde el navegador lo saltaba sin problema).
    match /activos/{activoId} {
      allow read:   if (request.auth != null && resource.data.userId == request.auth.uid) || isAdmin();
      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid && (
        !exists(/databases/$(database)/documents/tecnicos/$(request.auth.uid)) ||
        get(/databases/$(database)/documents/tecnicos/$(request.auth.uid)).data.plan in ['pro', 'empresa']
      );
      allow update: if (request.auth != null && resource.data.userId == request.auth.uid) || isAdmin();
      allow delete: if (request.auth != null && resource.data.userId == request.auth.uid) || isAdmin();
    }

    // Service history records — antes cualquier autenticado podía leer/editar
    // el historial de servicio de CUALQUIER equipo, no solo el propio.
    match /servicios/{servicioId} {
      allow read:   if (request.auth != null && resource.data.userId == request.auth.uid) || isAdmin();
      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;
      allow update: if (request.auth != null && resource.data.userId == request.auth.uid) || isAdmin();
      allow delete: if isAdmin();
    }

    // Care subscription plans — sin cobro automatizado todavía: cualquier
    // usuario podía updateDoc({estado:"activo"}) desde el navegador y
    // activarse un plan "pagado" gratis. `estado`/`montoPagado` ahora son
    // solo-admin hasta que exista un webhook de pago real para esto.
    match /planes_care/{planId} {
      allow read:   if (request.auth != null && resource.data.clienteId == request.auth.uid) || isAdmin();
      allow create: if request.auth != null && request.resource.data.clienteId == request.auth.uid;
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    // Cotizaciones — public read (cotizacionId is the "token").
    // El cliente público (sin login) SOLO puede cambiar `estado` a
    // aceptada/rechazada — antes "allow update: if true" dejaba reescribir
    // precio, datos del técnico o cualquier campo del documento completo.
    match /cotizaciones/{cotId} {
      allow read:   if true;
      // Beneficio Pro/Empresa (antes solo lo bloqueaba la UI de
      // Cotizaciones.jsx — un addDoc directo desde el navegador lo saltaba).
      allow create: if request.auth != null && request.resource.data.tecnicoId == request.auth.uid &&
        get(/databases/$(database)/documents/tecnicos/$(request.auth.uid)).data.plan in ['pro', 'empresa'];
      // El técnico solo puede seguir editando MIENTRAS el cliente no haya
      // respondido — antes podía cambiar precios de una cotización ya
      // aceptada/rechazada, sin que el cliente lo supiera ni la reconfirmara.
      allow update: if isAdmin()
        || (request.auth != null && resource.data.tecnicoId == request.auth.uid &&
            !(resource.data.estado in ['aceptada','rechazada']))
        || (
          // Solo decide UNA vez: antes se podía voltear aceptada↔rechazada
          // sin límite ni autenticación con solo tener el link, incluso
          // después de que EditorCotizacion ya la trataba como congelada.
          !(resource.data.estado in ['aceptada','rechazada']) &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['estado','updatedAt'])
          && request.resource.data.estado in ['aceptada','rechazada']
        );
      allow delete: if isAdmin();
    }

    // Folio counters (owner only)
    match /cotizaciones_folio/{tecnicoId} {
      allow read:   if request.auth != null && request.auth.uid == tecnicoId;
      allow write:  if request.auth != null && request.auth.uid == tecnicoId;
    }

    // Technician client directory — antes cualquier usuario autenticado
    // podía leer/editar/borrar el directorio de clientes de OTRO técnico
    // (IDOR). Ahora restringido al dueño (tecnicoId) o admin.
    match /clientes_tecnico/{clienteId} {
      allow read:   if (request.auth != null && resource.data.tecnicoId == request.auth.uid) || isAdmin();
      allow create: if request.auth != null && request.resource.data.tecnicoId == request.auth.uid;
      allow update, delete: if (request.auth != null && resource.data.tecnicoId == request.auth.uid) || isAdmin();
    }

    // Technician product catalog — mismo fix de IDOR que clientes_tecnico.
    match /productos_tecnico/{productoId} {
      allow read:   if (request.auth != null && resource.data.tecnicoId == request.auth.uid) || isAdmin();
      allow create: if request.auth != null && request.resource.data.tecnicoId == request.auth.uid;
      allow update, delete: if (request.auth != null && resource.data.tecnicoId == request.auth.uid) || isAdmin();
    }

    // Chat solicitudes — readable by both parties, writable by authenticated users
    match /solicitudes_chat/{solicitudId} {
      // Antes cualquier usuario autenticado podía leer/editar CUALQUIER
      // conversación con solo saber el id — ahora restringido a las dos
      // partes de esa solicitud (o admin). Ver auditoría del 16 ago.
      allow read:   if request.auth != null && (
        resource.data.clienteId == request.auth.uid ||
        resource.data.tecnicoId == request.auth.uid ||
        isAdmin()
      );
      allow create: if request.auth != null && request.resource.data.clienteId == request.auth.uid;
      allow update: if request.auth != null && (
        resource.data.clienteId == request.auth.uid ||
        resource.data.tecnicoId == request.auth.uid ||
        isAdmin()
      );
      allow delete: if false;

      match /mensajes/{mensajeId} {
        allow read: if request.auth != null && (
          get(/databases/$(database)/documents/solicitudes_chat/$(solicitudId)).data.clienteId == request.auth.uid ||
          get(/databases/$(database)/documents/solicitudes_chat/$(solicitudId)).data.tecnicoId == request.auth.uid ||
          isAdmin()
        );
        // Antes solo se exigía ser una de las dos partes — cualquiera podía
        // mandar autorId=<la otra persona> y falsificar lo que "dijo" en una
        // disputa. Ahora el autor solo puede ser quien firma la petición
        // (o "sistema" para los avisos automáticos de aceptar/rechazar).
        allow create: if request.auth != null && (
          get(/databases/$(database)/documents/solicitudes_chat/$(solicitudId)).data.clienteId == request.auth.uid ||
          get(/databases/$(database)/documents/solicitudes_chat/$(solicitudId)).data.tecnicoId == request.auth.uid ||
          isAdmin()
        ) && (
          (request.resource.data.autorId == request.auth.uid && request.resource.data.tipo == "mensaje") ||
          (request.resource.data.autorId == "sistema" && request.resource.data.tipo == "sistema")
        );
        allow update: if false;
        allow delete: if false;
      }
    }

    // Social validations — one per user-work-type combination. `validadorId`
    // debe ser quien firma la petición — antes cualquiera podía validar en
    // nombre de otro usuario.
    match /validaciones/{validacionId} {
      allow read:   if true;
      allow create: if request.auth != null && request.resource.data.validadorId == request.auth.uid;
      allow update: if false;
      allow delete: if isAdmin();
    }

    // Technician collaboration network (subcollection per user)
    match /red_colaboradores/{userId}/lista/{tecnicoId} {
      allow read:   if request.auth != null && request.auth.uid == userId;
      allow write:  if request.auth != null && request.auth.uid == userId;
    }

    // ── Agentes autónomos (Cloud Functions) — los agentes usan el Admin
    // SDK, que ignora estas reglas; son estrictas a propósito porque solo
    // protegen el acceso desde el cliente.

    // Notificaciones generadas por los agentes — cada usuario ve las suyas
    match /notificaciones/{id} {
      allow read, update: if (request.auth != null && resource.data.userId == request.auth.uid) || isAdmin();
      allow create: if isAdmin(); // el marketing masivo del admin crea desde el cliente; los agentes usan Admin SDK
      allow delete: if (request.auth != null && resource.data.userId == request.auth.uid) || isAdmin();
    }

    // Pagos — el dueño lee los suyos; el admin lee y registra pagos manuales
    match /pagos/{id} {
      allow read:   if (request.auth != null && resource.data.userId == request.auth.uid) || isAdmin();
      allow create: if isAdmin();
      allow update, delete: if isAdmin();
    }

    // Suscripciones pendientes de confirmación de Mercado Pago
    match /suscripcionesPendientes/{uid} {
      allow read:  if (request.auth != null && request.auth.uid == uid) || isAdmin();
      allow write: if false; // solo el backend (Admin SDK)
    }

    // Facturas CFDI — el dueño lee las suyas; el admin lee todas
    match /facturas/{id} {
      allow read:  if (request.auth != null && resource.data.userId == request.auth.uid) || isAdmin();
      allow write: if false; // solo el backend (Admin SDK)
    }

    // Logs de decisiones de agentes — evidencia para el XPRIZE.
    // Solo el admin (panel ERP) puede leerlos desde el cliente.
    match /aiLogs/{id} {
      allow read:  if isAdmin();
      allow write: if false; // solo los agentes (Admin SDK)
    }

    // Rate limiting interno — nunca accesible desde el cliente
    match /rateLimits/{id} {
      allow read, write: if false;
    }

    // Gastos del negocio (Admin ERP → Finanzas → Reporte XPRIZE)
    match /gastos/{id} {
      allow read, write: if isAdmin();
    }

    // Códigos promocionales (Admin ERP → Marketing).
    // La lectura es solo del admin: en abierto, cualquiera podía listar la
    // colección y quedarse con todos los códigos vigentes. La validación al
    // suscribirse ocurre server-side en `crearSuscripcion`, así que el
    // cliente no necesita leerlos.
    match /promos/{id} {
      allow read:  if isAdmin();
      allow write: if isAdmin();
    }

    // Tickets de soporte. Se crean vía Cloud Function (Admin SDK) para que
    // `prioridad` salga del plan real del usuario en Firestore, no de lo
    // que el cliente declare — si no, cualquiera podía mandar
    // prioridad:true y saltarse la cola de soporte "prioritario" de Pro.
    match /soporteTickets/{id} {
      allow read:  if (request.auth != null && resource.data.userId == request.auth.uid) || isAdmin();
      allow write: if isAdmin();
    }

    // Configuración general del sitio (config/general) y disclosures
    // financieros internos del XPRIZE (config/xprize) comparten colección.
    // Ningún componente público lee esto todavía (ver AdminConfig.jsx) — el
    // "true" anterior exponía sin querer el reporte financiero interno junto
    // con la config pública. Solo-admin hasta que algo público necesite leer
    // config/general puntualmente.
    match /config/{id} {
      allow read: if isAdmin();
      allow write: if isAdmin();
    }

    // Log de auditoría del ERP: toda acción del admin queda registrada
    match /adminLogs/{id} {
      allow read, create: if isAdmin();
      allow update, delete: if false; // el rastro no se edita ni se borra
    }
  }
}
